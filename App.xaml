<Application x:Class="BeaconLog.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <DataTemplate x:Key="JournalRowTemplate">
            <Grid Margin="5,7,10,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="54" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="3" MinHeight="18" CornerRadius="2" HorizontalAlignment="Left"
                        Background="{Binding ColorHex}" />
                <TextBlock Grid.Column="1" Text="{Binding ClockText}" ToolTip="{Binding DurationText}"
                           Foreground="#485564" HorizontalAlignment="Left" FontSize="13" />
                <DockPanel Grid.Column="2">
                    <Border DockPanel.Dock="Right" MaxWidth="106" Margin="8,0,0,0" VerticalAlignment="Top"
                            Padding="5,2" Background="#E8F4F4" CornerRadius="4" ToolTip="{Binding CategoryLabel}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CategoryLabel}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding CategoryLabel}" TextTrimming="CharacterEllipsis"
                                   FontSize="11" Foreground="#206168" />
                    </Border>
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="14" />
                </DockPanel>
            </Grid>
        </DataTemplate>
    </Application.Resources>
</Application>
