<Window x:Class="BeaconLog.BackupRestoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="从备份恢复" Icon="Assets/BeaconLog.ico" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="White" FontFamily="Segoe UI, Microsoft YaHei UI" UseLayoutRounding="True">
    <StackPanel Margin="22">
        <Label Content="选择完整备份" Target="{Binding ElementName=LocalBackups}" Padding="0" FontWeight="SemiBold" />
        <DockPanel Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Content="选择文件…" Margin="8,0,0,0" Padding="10,4" Click="Browse_Click" />
            <ComboBox x:Name="LocalBackups" DisplayMemberPath="Name" SelectedValuePath="FilePath" Padding="5,3"
                      SelectionChanged="LocalBackups_SelectionChanged" />
        </DockPanel>
        <TextBlock x:Name="Summary" Margin="0,9,0,0" Foreground="#536677" TextWrapping="Wrap" />
        <Label Content="恢复范围" Target="{Binding ElementName=ScopeChoice}" Margin="0,16,0,6"
               Padding="0" FontWeight="SemiBold" />
        <ComboBox x:Name="ScopeChoice" SelectedIndex="0" Padding="6,4"
                  SelectionChanged="ScopeChoice_SelectionChanged">
            <ComboBoxItem Content="仅恢复历史数据" />
            <ComboBoxItem Content="仅恢复设置" />
            <ComboBoxItem Content="恢复全部" />
        </ComboBox>
        <TextBlock x:Name="ScopeDescription" Margin="0,7,0,0" Foreground="#536677" TextWrapping="Wrap" />
        <TextBlock x:Name="RestoreError" Margin="0,7,0,0" Foreground="#A62727" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="取消" Padding="12,5" Margin="0,0,7,0" IsCancel="True" />
            <Button x:Name="RestoreButton" Content="恢复" IsEnabled="False" Padding="12,5"
                    Click="Restore_Click" />
        </StackPanel>
    </StackPanel>
</Window>
