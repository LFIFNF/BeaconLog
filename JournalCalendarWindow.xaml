<Window x:Class="BeaconLog.JournalCalendarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="记录日历" Width="620" Height="344" WindowStyle="None"
        WindowStartupLocation="Manual" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        FontFamily="Segoe UI, Microsoft YaHei UI" UseLayoutRounding="True"
        PreviewKeyDown="Calendar_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="CalendarDay" TargetType="Button">
            <Setter Property="Margin" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DayBorder" CornerRadius="5" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DayBorder" Property="BorderBrush" Value="#3A7A7D" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="DayBorder" Property="BorderBrush" Value="#1C565B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <TabControl x:Name="HistoryTabs" Background="Transparent" BorderThickness="0" Padding="0"
                KeyboardNavigation.TabNavigation="Cycle">
      <TabItem x:Name="DateTab" Header="按日期">
       <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="266" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Padding="12" Background="White" BorderBrush="#D8E3E9"
                BorderThickness="1" CornerRadius="9">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PreviousMonth" Content="‹" Width="29" Height="27" FontSize="18"
                            AutomationProperties.Name="上个月" Click="PreviousMonth_Click" />
                    <TextBlock x:Name="MonthTitle" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="15" FontWeight="SemiBold" Foreground="#243444" />
                    <Button x:Name="NextMonth" Grid.Column="2" Content="›" Width="29" Height="27" FontSize="18"
                            AutomationProperties.Name="下个月" Click="NextMonth_Click" />
                </Grid>
                <UniformGrid DockPanel.Dock="Top" Rows="1" Columns="7" Height="22"
                             TextBlock.Foreground="#576B7C" Margin="0,0,0,3">
                    <TextBlock Text="一" TextAlignment="Center" />
                    <TextBlock Text="二" TextAlignment="Center" />
                    <TextBlock Text="三" TextAlignment="Center" />
                    <TextBlock Text="四" TextAlignment="Center" />
                    <TextBlock Text="五" TextAlignment="Center" />
                    <TextBlock Text="六" TextAlignment="Center" />
                    <TextBlock Text="日" TextAlignment="Center" />
                </UniformGrid>
                <Button x:Name="TodayButton" DockPanel.Dock="Bottom" Content="回到今天" HorizontalAlignment="Left"
                        Margin="0,9,0,0" Padding="8,4" Click="Today_Click" />
                <UniformGrid x:Name="DaysGrid" Rows="6" Columns="7" />
            </DockPanel>
        </Border>

        <Border x:Name="PreviewPanel" Grid.Column="2" Visibility="Hidden"
                Padding="11" Background="White" BorderBrush="#D8E3E9" BorderThickness="1" CornerRadius="9"
                MouseEnter="PreviewPanel_MouseEnter" MouseLeave="PreviewPanel_MouseLeave">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="4,0,4,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="PreviewDate" FontSize="15" FontWeight="SemiBold" Foreground="#243444" />
                        <TextBlock x:Name="PreviewCount" Margin="0,3,0,0" Foreground="#576B7C" />
                    </StackPanel>
                    <TextBlock x:Name="PinnedStatus" Grid.Column="1" Text="已固定" Visibility="Collapsed"
                               VerticalAlignment="Top" Foreground="#176369" />
                </Grid>
                <Border DockPanel.Dock="Top" Height="1" Background="#E4E8EC" Margin="0,0,0,3" />
                <TextBlock x:Name="PreviewEmpty" DockPanel.Dock="Top" Visibility="Collapsed" Text="当天暂无记录"
                           Foreground="#576B7C" Margin="4,8,4,0" />
                <ListBox x:Name="PreviewList" AutomationProperties.Name="当天记录" BorderThickness="0"
                         HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.ScrollUnit="Pixel" ItemTemplate="{StaticResource JournalRowTemplate}"
                         PreviewKeyDown="PreviewList_PreviewKeyDown">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding Text}" />
                            <EventSetter Event="MouseDoubleClick" Handler="PreviewRow_MouseDoubleClick" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>
       </Grid>
      </TabItem>
      <TabItem Header="按分类">
        <Border Padding="12" Background="White" BorderBrush="#D8E3E9" BorderThickness="1" CornerRadius="9">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <ComboBox x:Name="CategoryFilter" Width="178" Padding="6,4"
                              AutomationProperties.Name="历史分类" SelectionChanged="CategoryFilter_SelectionChanged" />
                    <TextBlock x:Name="CategoryCount" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#576B7C" />
                </StackPanel>
                <TextBlock x:Name="CategoryEmpty" DockPanel.Dock="Top" Text="此分类暂无记录"
                           Foreground="#576B7C" Margin="5,5,0,0" Visibility="Collapsed" />
                <ListBox x:Name="CategoryHistoryList" AutomationProperties.Name="分类历史记录" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"
                         VirtualizingPanel.ScrollUnit="Pixel" PreviewKeyDown="PreviewList_PreviewKeyDown"
                         IsVisibleChanged="CategoryHistoryList_IsVisibleChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding Text}" />
                            <EventSetter Event="MouseDoubleClick" Handler="PreviewRow_MouseDoubleClick" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding DateText}" Margin="19,5,0,0" FontSize="12" Foreground="#576B7C" />
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource JournalRowTemplate}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
      </TabItem>
    </TabControl>
</Window>
