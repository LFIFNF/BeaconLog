<Window x:Class="BeaconLog.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BeaconLog"
        Title="BeaconLog" Icon="Assets/BeaconLog.ico" Width="520" Height="650"
        MinWidth="490" MinHeight="440"
        WindowStartupLocation="CenterScreen"
        Background="#FFFFFF"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        UseLayoutRounding="True">
    <Window.Resources>
        <ContextMenu x:Key="JournalRowMenu" x:Shared="False">
            <MenuItem Header="编辑" Click="JournalMenuEdit_Click" />
            <MenuItem Header="删除" Click="JournalMenuDelete_Click" />
        </ContextMenu>
        <Geometry x:Key="OpenFloatingIcon">M 2,3 L 18,3 18,14 2,14 Z M 7,18 L 13,18 M 10,14 L 10,18 M 7,8.5 L 13,8.5 M 10,5.5 L 10,11.5</Geometry>
        <Geometry x:Key="CloseFloatingIcon">M 2,3 L 18,3 18,14 2,14 Z M 7,18 L 13,18 M 10,14 L 10,18 M 8,6.5 L 12,10.5 M 12,6.5 L 8,10.5</Geometry>
        <Geometry x:Key="CategoriesIcon">M 3,3 L 10,3 17,10 10,17 3,10 Z M 6.4,6.8 A 0.7,0.7 0 1 0 7.8,6.8 A 0.7,0.7 0 1 0 6.4,6.8 M 13,3 L 19,9</Geometry>
        <DataTemplate x:Key="ToolbarGlyph">
            <Path Width="18" Height="18" Stretch="Uniform" StrokeThickness="1.45"
                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="{Binding}" />
        </DataTemplate>
        <DataTemplate x:Key="TimelineGlyph">
            <Canvas Width="18" Height="18">
                <Path Stroke="#284354" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeEndLineCap="Round"
                      Data="M 1,12 L 4,12 9,8 14,5 17,5 M 2,16 L 16,16" />
                <Ellipse Width="5" Height="5" Canvas.Left="1.5" Canvas.Top="9.5" Fill="#26A6A8" />
                <Ellipse Width="5" Height="5" Canvas.Left="6.5" Canvas.Top="5.5" Fill="#E17B3F" />
                <Ellipse Width="5" Height="5" Canvas.Left="11.5" Canvas.Top="2.5" Fill="#7A63BA" />
            </Canvas>
        </DataTemplate>
        <Geometry x:Key="HistoryIcon">M 3,4 L 17,4 17,18 3,18 Z M 6,2 L 6,6 M 14,2 L 14,6 M 3,8 L 17,8 M 6,11 L 8,11 M 12,11 L 14,11 M 6,14 L 8,14 M 12,14 L 14,14</Geometry>
        <Geometry x:Key="SettingsIcon">M 8,2 L 12,2 12.7,4.6 14.5,5.6 17,4.9 19,8.2 17.2,10 17.2,11 19,12.8 17,16.1 14.5,15.4 12.7,16.4 12,19 8,19 7.3,16.4 5.5,15.4 3,16.1 1,12.8 2.8,11 2.8,10 1,8.2 3,4.9 5.5,5.6 7.3,4.6 Z M 10,7.6 A 2.9,2.9 0 1 0 10,13.4 A 2.9,2.9 0 1 0 10,7.6</Geometry>
        <Style x:Key="ToolbarIconButton" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="#F5F8FA" />
            <Setter Property="BorderBrush" Value="#E2E8EC" />
            <Setter Property="Foreground" Value="#284354" />
            <Setter Property="ContentTemplate" Value="{StaticResource ToolbarGlyph}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#E8F3F6" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#D5EAEE" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#378A91" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="26,22,26,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Margin="0,0,10,0" VerticalAlignment="Center"
                      DataContext="{x:Static local:StatusBallAppearance.Current}">
                    <Ellipse Width="{Binding BackgroundDiameter}" Height="{Binding BackgroundDiameter}"
                             Fill="{Binding BackgroundFill}" Opacity="0.5" />
                    <Button x:Name="MainBall" AutomationProperties.Name="状态球"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Width="{Binding Diameter}" Height="{Binding Diameter}"
                            Background="{Binding Fill}" Cursor="Hand" Click="Ball_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Ellipse Fill="{TemplateBinding Background}" />
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
                <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock x:Name="FloatingStatus" Text="未开启悬浮窗" FontSize="12" Foreground="#485564"
                               AutomationProperties.LiveSetting="Polite" />
                    <TextBlock x:Name="ElapsedStatus" Text="已经过 0 分钟" FontSize="12" Foreground="#485564" />
                </StackPanel>
                <Button x:Name="FloatingToggle" Content="{StaticResource OpenFloatingIcon}" ToolTip="打开悬浮窗"
                        Style="{StaticResource ToolbarIconButton}" VerticalAlignment="Center"
                        Background="#F0FAFB" BorderBrush="#D4EEF1" Foreground="#116573"
                        Click="ToggleFloatingWindow_Click" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="JournalCategoriesButton" Content="{StaticResource CategoriesIcon}" ToolTip="记录分类"
                        Style="{StaticResource ToolbarIconButton}" Margin="0,0,6,0"
                        Click="OpenJournalCategories_Click" />
                <Button x:Name="TimelineButton" Content="颜色时间表" ContentTemplate="{StaticResource TimelineGlyph}" ToolTip="颜色时间表"
                        Style="{StaticResource ToolbarIconButton}" Margin="0,0,6,0"
                        Click="OpenStatusBallSettings_Click" />
                <Button x:Name="JournalDateButton" Content="{StaticResource HistoryIcon}" ToolTip="历史"
                        Style="{StaticResource ToolbarIconButton}" Margin="0,0,6,0" Click="JournalDate_Click" />
                <Button x:Name="SettingsButton" Content="{StaticResource SettingsIcon}" ToolTip="设置"
                        Style="{StaticResource ToolbarIconButton}"
                        Click="OpenSettings_Click" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Height="1" Background="#E4E8EC" />
        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="JournalError" DockPanel.Dock="Top" Visibility="Collapsed"
                       Margin="0,0,0,8" Foreground="#A62727" TextWrapping="Wrap" />
            <TextBlock x:Name="JournalEmpty" DockPanel.Dock="Top" Visibility="Collapsed"
                       Text="当天暂无记录" Foreground="#576B7C" Margin="5,5,0,0" />
            <ListBox x:Name="JournalList" AutomationProperties.Name="记事记录" BorderThickness="0"
                     HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     Background="Transparent" PreviewKeyDown="JournalList_PreviewKeyDown"
                     ItemTemplate="{StaticResource JournalRowTemplate}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,2" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding Text}" />
                        <Setter Property="ContextMenu" Value="{StaticResource JournalRowMenu}" />
                        <EventSetter Event="MouseDoubleClick" Handler="JournalRow_MouseDoubleClick" />
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </DockPanel>
    </Grid>
</Window>
