<Window x:Class="BeaconLog.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Icon="Assets/BeaconLog.ico" Width="520" Height="650"
        MinWidth="380" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="#F5F7F9"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#DFE8ED" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="15,8" />
        </Style>
        <Style x:Key="SettingsHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#243444" />
            <Setter Property="Margin" Value="0,16,0,7" />
        </Style>
        <Style x:Key="SettingsToggle" TargetType="CheckBox">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#253748" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Row" Padding="0,7" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="5">
                            <DockPanel>
                                <Border x:Name="Track" DockPanel.Dock="Right" Width="34" Height="19"
                                        Margin="10,0,0,0" Background="#CBD7E0" CornerRadius="10" Padding="3">
                                    <Ellipse x:Name="Thumb" Width="13" Height="13" Fill="White" HorizontalAlignment="Left" />
                                </Border>
                                <ContentPresenter VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#16757A" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#F2F8FA" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Row" Property="BorderBrush" Value="#50959A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsAction" TargetType="Button">
            <Setter Property="Padding" Value="11,5" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Foreground" Value="#245C63" />
            <Setter Property="Background" Value="#ECF6F6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Padding="{TemplateBinding Padding}" CornerRadius="6"
                                Background="{TemplateBinding Background}" BorderThickness="1" BorderBrush="#CFE2E5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#DDEFF1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#CEE6E9" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#378A91" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#F5F7F9">
        <StackPanel Margin="22,6,22,22">
            <TextBlock Text="启动" Style="{StaticResource SettingsHeading}" />
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <CheckBox x:Name="StartAtLoginOption" Content="开机自启" Style="{StaticResource SettingsToggle}" Click="SaveOption_Click" />
                    <CheckBox x:Name="SilentStartupOption" Content="静默启动" Style="{StaticResource SettingsToggle}" Click="SaveOption_Click" />
                    <TextBlock Margin="1,0,0,4" FontSize="12" Foreground="#536677" TextWrapping="Wrap"
                               Text="仅在开机自启时生效。手动启动始终打开主窗口。" />
                    <CheckBox x:Name="OpenFloatingWindowOption" Content="软件启动时打开悬浮窗"
                              Style="{StaticResource SettingsToggle}" Click="SaveOption_Click" />
                </StackPanel>
            </Border>

            <TextBlock Text="悬浮窗与状态球" Style="{StaticResource SettingsHeading}" />
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <CheckBox x:Name="HideWhenFullscreenOption" Content="全屏时隐藏"
                              Style="{StaticResource SettingsToggle}" Click="SaveOption_Click" />
                    <DockPanel Margin="0,7,0,4">
                        <TextBlock DockPanel.Dock="Right" Foreground="#206168"
                                   Text="{Binding Value, ElementName=DiameterSlider, StringFormat={}{0:0} DIP}" />
                        <Label Content="状态球大小" Target="{Binding ElementName=DiameterSlider}" Padding="0" FontSize="14" />
                    </DockPanel>
                    <Slider x:Name="DiameterSlider" Margin="0,4,0,5" TickFrequency="1"
                            IsSnapToTickEnabled="True" ValueChanged="DiameterSlider_ValueChanged" />
                    <TextBlock x:Name="SizeError" Foreground="#A62727" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock Text="数据" Style="{StaticResource SettingsHeading}" />
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <CheckBox x:Name="AutoBackupOption" Content="自动备份"
                              Style="{StaticResource SettingsToggle}" Click="SaveOption_Click" />
                    <TextBlock x:Name="BackupStatus" Foreground="#536677" FontSize="12" TextWrapping="Wrap" />
                    <WrapPanel Margin="0,10,0,2">
                        <Button Content="导出历史" Style="{StaticResource SettingsAction}" Margin="0,0,7,4" Click="ExportHistory_Click" />
                        <Button Content="立即备份" Style="{StaticResource SettingsAction}" Margin="0,0,7,4" Click="BackupNow_Click" />
                        <Button Content="恢复" Style="{StaticResource SettingsAction}" Margin="0,0,0,4" Click="Restore_Click" />
                    </WrapPanel>
                    <TextBlock x:Name="DataFeedback" Foreground="#206168" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
