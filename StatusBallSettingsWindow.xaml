<Window x:Class="BeaconLog.StatusBallSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BeaconLog"
        Title="颜色时间表" Icon="Assets/BeaconLog.ico" Width="560" Height="620"
        MinWidth="440" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="White"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        UseLayoutRounding="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="26">
            <ListBox x:Name="RuleList" Height="166" AutomationProperties.Name="颜色规则"
                     HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="RuleList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="63" />
                                <ColumnDefinition Width="66" />
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="83" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="14" Height="14" Fill="{Binding ColorHex}" HorizontalAlignment="Left" />
                            <TextBlock Grid.Column="1" Text="{Binding DisplayTitle}" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding DisplayTitle}" Margin="0,0,6,0" />
                            <TextBlock Grid.Column="2" Text="{Binding Minutes, StringFormat={}{0} 分钟}" />
                            <TextBlock Grid.Column="3" Text="{Binding ColorHex}" />
                            <TextBlock Grid.Column="4">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="到时切换" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Gradient}" Value="True">
                                                <Setter Property="Text" Value="渐变" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Grid.Column="5" Text="{Binding ReminderMinutes, StringFormat=每 {0} 分钟提醒}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RippleReminder}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <WrapPanel Margin="0,8,0,0">
                <WrapPanel.Resources>
                    <Style TargetType="Button">
                        <Setter Property="Padding" Value="10,4" />
                        <Setter Property="Margin" Value="0,0,6,4" />
                    </Style>
                </WrapPanel.Resources>
                <Button Content="添加" Click="AddRule_Click" />
                <Button x:Name="EditRule" Content="编辑" IsEnabled="False" Click="EditRule_Click" />
                <Button x:Name="DeleteRule" Content="删除" IsEnabled="False" Click="DeleteRule_Click" />
                <Button x:Name="MoveUp" Content="上移" IsEnabled="False" Click="MoveUp_Click" />
                <Button x:Name="MoveDown" Content="下移" IsEnabled="False" Click="MoveDown_Click" />
            </WrapPanel>
            <TextBlock x:Name="RuleError" Margin="0,4,0,0" Foreground="#A62727" TextWrapping="Wrap" />

            <Border x:Name="RuleEditor" Visibility="Collapsed" Padding="12" Margin="0,8,0,0"
                    Background="#F6F8FA" CornerRadius="8">
                <StackPanel>
                    <TextBlock x:Name="EditorTitle" FontWeight="SemiBold" />
                    <Label Content="颜色标题" Target="{Binding ElementName=RuleTitle}" Padding="0" Margin="0,8,0,3" />
                    <TextBox x:Name="RuleTitle" Padding="5,3" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                        <Label Content="时长（分钟）" Target="{Binding ElementName=RuleMinutes}" />
                        <TextBox x:Name="RuleMinutes" Width="62" Padding="5,3" />
                        <CheckBox x:Name="RuleGradient" Content="渐变" VerticalAlignment="Center" Margin="14,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="目标颜色" Margin="0,0,0,6" />
                    <local:StatusBallColorPicker x:Name="RuleColor" />
                    <StackPanel x:Name="ReminderFields" Orientation="Horizontal" Margin="0,10,0,0">
                        <CheckBox x:Name="RuleReminder" Content="涟漪提醒" VerticalAlignment="Center" />
                        <Label Content="间隔（分钟）" Target="{Binding ElementName=ReminderMinutes}" Margin="10,0,0,0" />
                        <TextBox x:Name="ReminderMinutes" Width="62" Padding="5,3" />
                    </StackPanel>
                    <TextBlock x:Name="EditorError" Margin="0,4,0,0" Foreground="#A62727" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="保存规则" Padding="10,4" Margin="0,0,6,0" Click="SaveRule_Click" />
                        <Button Content="取消" Padding="10,4" Click="CancelRule_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Window>
