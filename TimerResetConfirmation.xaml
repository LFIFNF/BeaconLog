<Window x:Class="BeaconLog.TimerResetConfirmation" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="重置计时" Width="168" Height="81"
        WindowStyle="None" WindowStartupLocation="Manual" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        FontFamily="Segoe UI, Microsoft YaHei UI" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="ConfirmationAction" TargetType="Button">
            <Setter Property="Width" Value="59" />
            <Setter Property="Height" Value="29" />
            <Setter Property="BorderBrush" Value="#DBE4E9" />
            <Setter Property="Background" Value="#F5F8FA" />
            <Setter Property="Foreground" Value="#243444" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderThickness="1"
                                BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#6C9199" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#287780" />
                                <Setter TargetName="Surface" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border CornerRadius="9" Background="White" BorderBrush="#DAE4E9" BorderThickness="1"
            Padding="11,9" KeyboardNavigation.TabNavigation="Cycle">
        <StackPanel>
            <TextBlock Text="重置计时？" FontSize="14" FontWeight="SemiBold" Foreground="#243444" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,7,0,0">
                <Button x:Name="CancelButton" Content="取消" Style="{StaticResource ConfirmationAction}"
                        Margin="0,0,7,0" Click="Cancel_Click" />
                <Button x:Name="ConfirmButton" Content="重置" Style="{StaticResource ConfirmationAction}"
                        Background="#176971" Foreground="White" BorderBrush="#176971" Click="Confirm_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
